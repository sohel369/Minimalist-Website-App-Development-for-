rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow any authenticated user to read/write specific collections
    // This is required for your User Booking and Admin Panel to work
    
    match /requests/{requestId} {
      allow read, write: if request.auth != null;
    }
    
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Default deny for safety
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
